{
  "name": "babel-preset-gatsby",
  "version": "3.17.0-next.0",
  "author": "Philipp Spiess <hello@philippspiess.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/gatsbyjs/gatsby.git",
    "directory": "packages/babel-preset-gatsby"
  },
  "homepage": "https://github.com/gatsbyjs/gatsby/tree/master/packages/babel-preset-gatsby#readme",
  "dependencies": {
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-transform-classes": "^8.0.1",
    "@babel/plugin-transform-class-properties": "^8.0.1",
    "@babel/plugin-transform-nullish-coalescing-operator": "^8.0.1",
    "@babel/plugin-transform-optional-chaining": "^8.0.1",
    "@babel/plugin-transform-runtime": "^8.0.1",
    "@babel/plugin-transform-spread": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-react": "^8.0.1",
    "@babel/runtime": "^8.0.0",
    "babel-plugin-dynamic-import-node": "^2.3.3",
    "babel-plugin-macros": "^3.1.0",
    "babel-plugin-transform-react-remove-prop-types": "^0.4.24",
    "gatsby-core-utils": "^4.17.0-next.0",
    "gatsby-legacy-polyfills": "^3.17.0-next.0"
  },
  "peerDependencies": {
    "@babel/core": "^7.11.6",
    "core-js": "^3.0.0"
  },
  "license": "MIT",
  "main": "index.js",
  "scripts": {
    "build": "babel src --out-dir . --ignore \"**/__tests__\" --ignore \"**/utils/path-serializer.ts\" --extensions \".ts,.js\"",
    "prepare": "cross-env NODE_ENV=production npm run build",
    "watch": "babel -w src --out-dir . --ignore \"**/__tests__\" --ignore \"**/utils/path-serializer.ts\" --extensions \".ts,.js\""
  },
  "devDependencies": {
    "@babel/cli": "^8.0.4",
    "babel-preset-gatsby-package": "^3.17.0-next.0",
    "cross-env": "^10.1.0"
  },
  "engines": {
    "node": ">=18.0.0 <26"
  }
}
