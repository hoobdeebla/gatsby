{
  "name": "gatsby-source-npm-package-search",
  "description": "Search NPM packages and pull NPM & GitHub metadata from Algolia's NPM index",
  "version": "5.17.0-next.0",
  "author": "james.a.stack@gmail.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/gatsbyjs/gatsby.git",
    "directory": "packages/gatsby-source-npm-package-search"
  },
  "homepage": "https://github.com/gatsbyjs/gatsby/tree/master/packages/gatsby-source-npm-package-search#readme",
  "dependencies": {
    "@babel/runtime": "^8.0.0",
    "algoliasearch": "^5.57.0"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.4",
    "@babel/core": "^8.0.1",
    "babel-preset-gatsby-package": "^3.17.0-next.0",
    "cross-env": "^10.1.0"
  },
  "keywords": [
    "gatsby",
    "gatsby-plugin"
  ],
  "license": "MIT",
  "main": "index.js",
  "peerDependencies": {
    "gatsby": "^5.0.0-next"
  },
  "scripts": {
    "build": "babel src --out-dir . --ignore \"**/__tests__\"",
    "prepare": "cross-env NODE_ENV=production npm run build",
    "watch": "babel -w src --out-dir . --ignore \"**/__tests__\""
  },
  "engines": {
    "node": ">=18.0.0 <26"
  }
}
